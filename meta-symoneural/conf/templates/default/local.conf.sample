# SymoNeuRaL Local Configuration Sample
#
# This file sets up the default environment for the SymoNeuRaL distribution.
# It is copied to conf/local.conf when you initialize a build.
#

# =========================================================================
# Machine Selection
# =========================================================================
# Choose your target hardware. Only one should be active at a time.

# --- SymoNeuRaL Custom Machines ---
# Primary Desktop (Alienware R11 + RTX 5070 Ti)
MACHINE ?= "alienware-r11"

# Discrete GPU Testing Focus
# MACHINE ?= "nvidia-rtx50-series"

# Embedded Target
# MACHINE ?= "rpi4-64"

# --- Standard Yocto Debug Targets ---
# Use these for quick testing in QEMU (Emulator)
# MACHINE ?= "qemux86-64"
# MACHINE ?= "qemuarm64"
# MACHINE ?= "genericx86-64"

# Default Fallback (if nothing else is set)
MACHINE ??= "alienware-r11"

# =========================================================================
# Distribution Policy
# =========================================================================
# We use the custom "symonos" distro instead of standard SymoNeuRaL.
DISTRO ?= "symonos"

# Package Management:
# Using RPM is standard, but you can switch to 'package_deb' if you prefer
# apt-get style management on the device.
PACKAGE_CLASSES ?= "package_rpm"

# SDK Target Architecture (Build SDKs for 64-bit hosts)
SDKMACHINE ?= "x86_64"

# =========================================================================
# Build Speed & Caching (HIGHLY RECOMMENDED)
# =========================================================================
# These settings allow Bitbake to download pre-compiled binaries from the
# Yocto Project servers, saving you HOURS of compile time.

BB_HASHSERVE_UPSTREAM = 'wss://hashserv.yoctoproject.org/ws'
SSTATE_MIRRORS ?= "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH"
BB_HASHSERVE = "auto"
BB_SIGNATURE_HANDLER = "OEEquivHash"

# =========================================================================
# License Flags (Crucial for NVIDIA)
# =========================================================================
# This allows the build to use proprietary drivers (NVIDIA) and codecs (ffmpeg).
LICENSE_FLAGS_ACCEPTED = "commercial synaptics-killswitch"

# =========================================================================
# Standard System Paths
# =========================================================================
# Where to download source tarballs
# DL_DIR ?= "${TOPDIR}/downloads"

# Where to store the shared state cache
# SSTATE_DIR ?= "${TOPDIR}/sstate-cache"

# Where to perform the build work
# TMPDIR = "${TOPDIR}/tmp"

# =========================================================================
# Image Features
# =========================================================================
# Extra features to bake into the image.
# - "debug-tweaks" allows root login without a password (DEV ONLY)
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"

# Add build statistics to help analyze performance
USER_CLASSES ?= "buildstats"

# Interactive shell config (patches)
PATCHRESOLVE = "noop"

# =========================================================================
# Disk Space Monitoring
# =========================================================================
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# =========================================================================
# QEMU Configuration
# =========================================================================
PACKAGECONFIG:append:pn-qemu-system-native = " sdl"

# Config Version (Do not change)
CONF_VERSION = "2"
