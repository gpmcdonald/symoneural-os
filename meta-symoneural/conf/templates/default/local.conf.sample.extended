# SymoNeuRaL Extended Configuration
# =================================
# This file contains advanced settings for the SymoNeuRaL distro.
# Copy snippets from here into your local.conf as needed.
#

# =========================================================================
# Parallelism Options (Tuned for Alienware R11)
# =========================================================================
# BitBake detects CPU cores automatically, but you can force limits here
# if you want to keep the PC usable during builds.
#
# BB_NUMBER_THREADS ?= "16"
# PARALLEL_MAKE ?= "-j 16"

# =========================================================================
# Graphical & Distro Features
# =========================================================================
# Since we are using NVIDIA Hardware, we want OpenGL, Vulkan, and X11/Wayland.
# We explicitly enable these instead of DirectFB.

DISTRO_FEATURES:append = " opengl vulkan x11 wayland systemd"
DISTRO_FEATURES:remove = " directfb"

# =========================================================================
# System Initialization (Systemd)
# =========================================================================
# SymoNeuRaL uses systemd by default for modern service management.
INIT_MANAGER = "systemd"

# =========================================================================
# Proprietary Drivers & Codecs (Crucial for NVIDIA)
# =========================================================================
# Unblocked commercial licenses for GPU drivers and media codecs (MP3/MP4).
LICENSE_FLAGS_ACCEPTED = "commercial synaptics-killswitch"

# =========================================================================
# Locale Generation
# =========================================================================
# Save build time by only generating US English.
GLIBC_GENERATE_LOCALES = "en_US.UTF-8"
IMAGE_LINGUAS ?= "en-us"

# =========================================================================
# Debugging & Optimization
# =========================================================================
# Uncomment to enable debugging symbols (huge space increase)
# DEBUG_BUILD = "1"

# Uncomment to disable stripping binaries (useful for on-device debugging)
# INHIBIT_PACKAGE_STRIP = "1"

# =========================================================================
# Multi-lib Support (32-bit apps on 64-bit OS)
# =========================================================================
# Useful if running legacy binary-only applications (like SteamCMD).
# require conf/multilib.conf
# MULTILIBS = "multilib:lib32"
# DEFAULTTUNE:virtclass-multilib-lib32 = "x86"

# =========================================================================
# Disk Space Monitoring
# =========================================================================
# Abort the build if disk space runs dangerously low.
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# =========================================================================
# Build History & Stats
# =========================================================================
# Collects performance data to graph how long tasks take.
USER_CLASSES ?= "buildstats"

# Commit build history to a git repo (useful to track package size bloat)
# INHERIT += "buildhistory"
# BUILDHISTORY_COMMIT = "1"

# =========================================================================
# Archiver
# =========================================================================
# Uncomment to archive all source code (GPL compliance).
# INHERIT += "archiver"
# ARCHIVER_MODE[src] = "original"

# =========================================================================
# Security Flags
# =========================================================================
# Hardening flags for production images (Stack styling, PIE, etc.)
require conf/distro/include/security_flags.inc
